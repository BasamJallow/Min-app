# Kopiér denne fil til .env og indsæt jeres egen nøgle efter =
# .env er i .gitignore og bliver aldrig uploadet til GitHub.
EXPO_PUBLIC_OPENAI_API_KEY=
# Valgfri: hvilken OpenAI-model appen skal bruge.
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
# Valgfri: modeller til tale i jobsamtalen (tale til tekst og AI-stemme).
EXPO_PUBLIC_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
EXPO_PUBLIC_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
EXPO_PUBLIC_OPENAI_VOICE=alloy

# Valgfri: Stripe Payment Link til "PrepPal Pro" (fra Stripe Dashboard, sandkasse).
EXPO_PUBLIC_STRIPE_PAYMENT_LINK=
